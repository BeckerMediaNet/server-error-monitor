# ============================================================
# Server Error Monitor — per-server configuration
# Copy this file to ".env" in the same directory and fill in
# the values for THIS server. Never commit the real .env to
# git or share it — it contains your Slack webhook URL.
# ============================================================

# Slack Incoming Webhook URL for the channel that should receive alerts.
# Create one at https://api.slack.com/messaging/webhooks (or ask your
# Slack admin for the webhook for #site-alerts or similar).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/HERE

# Site URL shown at the top of Slack messages so you know which site fired.
SITE_LABEL="example.com"

# Host access log files to watch, space-separated. Wildcards are expanded
# on every run, so new per-site logs are picked up automatically. Rotated
# copies (access.log.1, *.gz, access_log-20260101) are always skipped.
# Must be quoted if it contains spaces or wildcards. Set to "" when every
# site runs in Docker and only DOCKER_CONTAINERS is used.
# The log format must contain `"<request>" <status> ` — nginx's default
# "combined" format, nginx-proxy's "vhost" format and Apache's
# combined/common formats all do.
ACCESS_LOGS="/var/log/nginx/*access*log"

# Docker containers whose stdout is an access log, space-separated names
# (see `docker ps`). nginx-proxy and the official nginx/httpd images log
# requests to stdout, so they never appear under /var/log.
# With a reverse proxy (e.g. jwilder/nginx-proxy) in front of the sites,
# list ONLY the proxy: it sees every request, including the 502/503s it
# returns when a site's container is down. Also listing the web server
# containers behind it would count each request twice.
DOCKER_CONTAINERS=

# HTTP status codes to monitor, comma-separated. Exact codes (502) and/or
# whole classes (5xx, 4xx) — e.g. "5xx,404,429". A 403 only counts when a
# visitor was refused: scanner paths (/.env, /wp-login.php, xmlrpc.php,
# /wp-admin/, backups) and POSTs with no Referer never do. Remove 403 to stop
# monitoring 403s, refused form POSTs included.
ERROR_CODES=403,500,502,503,504

# Alert when real visitors got any single monitored code MORE than this many
# times since the previous run (~5 minutes when run from cron). Errors scored
# as bots (see BOT_FILTER below) don't count.
ERROR_THRESHOLD=50

# Optional per-code overrides of ERROR_THRESHOLD, one line per code, e.g.
# for a noisy 404 rate:
# THRESHOLD_404=300
# THRESHOLD_429=100

# Watch the kernel log for php-fpm segfaults / general protection faults.
CHECK_KERNEL=true

# Where to read kernel messages from: "auto" (systemd journal if available,
# else /var/log/kern.log, else /var/log/messages), "journal", or a file path.
KERNEL_LOG_SOURCE=auto

# Alert when there are AT LEAST this many php-fpm segfaults + general
# protection faults (combined) since the previous run. Containers share the
# host's kernel, so this also catches php-fpm crashing inside Docker.
KERNEL_FAULT_THRESHOLD=3

# Process name prefix to look for in kernel fault lines. "php-fpm" matches
# php-fpm, php-fpm7.4, php-fpm8.2, etc.
KERNEL_FAULT_PROCESS=php-fpm

# While 403 is monitored, ANY form POST a visitor sent that was refused with a
# 403 alerts, per site: a browser POST that carried its page as Referer, to
# admin-ajax.php, a form plugin's REST route or a page (bots and scanners send
# no Referer). false = only the 403 count above.
# FORM_403_CHECK=true

# Every code's count also needs at least this many different real visitors,
# so one client hammering a page doesn't alert. MIN_CLIENTS_<code> overrides it
# for one code (MIN_CLIENTS_403 from before the bot filter still works). From a
# private address (a load balancer in front), a client is the address plus the
# browser.
# MIN_REAL_CLIENTS=3

# Bot filter: every error is scored as bot or real traffic, and only real
# visitors' errors count toward ERROR_THRESHOLD. Always bots: requests sent to
# the bare server IP, scanner paths (/.env, /.git/, backups, config files,
# stray .php, readme.html), malformed requests, no user agent, scripts (curl, python, ...),
# self-declared bots and search engine crawlers. Everyone else is scored on
# what they did since the last run (old browser, HEAD, HTTP/1.0, also probed
# /.env, worked through a list of paths, never got a page: up; loaded the
# page's css/js/images, came from the site's own pages: down). A score of
# BOT_SCORE_THRESHOLD or more is a bot. `check-server-errors.sh --explain`
# shows what it made of this server's traffic. false = count every error.
# BOT_FILTER=true
# BOT_SCORE_THRESHOLD=3

# Outage check (5xx only): alert anyway when normal pages of named sites got
# MORE than OUTAGE_THRESHOLD of one code from at least OUTAGE_MIN_CLIENTS
# clients, bots included: a server that gives bots a 502 for the home page is
# down for visitors too. Bare-IP, scanner-path and malformed requests still
# don't count. 0 = off.
# OUTAGE_THRESHOLD=100
# OUTAGE_MIN_CLIENTS=10

# While a problem continues, repeat the Slack alert at most once per this
# many minutes so the channel isn't spammed every 5 minutes.
ALERT_COOLDOWN_MINUTES=60

# How many consecutive runs a problem must stay under its threshold before
# a "recovered" message is sent (2 runs = ~10 minutes).
RECOVERY_RUNS=2

# How many top paths / client IPs to list in an HTTP error alert.
TOP_N=5

# How many real and bot clients --explain lists.
# EXPLAIN_TOP=25

# Where to keep the small state files this script writes (log offsets,
# alert timestamps). Defaults to a "state" folder next to this script.
STATE_DIR=
